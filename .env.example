# Salin menjadi `.env` bila ingin mengganti kredensial demo.
# Tanpa `.env`, docker-compose.db.yml memakai nilai default yang sama.
# File `.env` tidak di-commit (lihat .gitignore).

MARIADB_DATABASE=lb_demo
MARIADB_USER=lb_app
MARIADB_PASSWORD=lb_app_password
MARIADB_ROOT_PASSWORD=lb_root_password

# User khusus exporter metrik MariaDB (dibuat oleh `make db-grant-exporter`,
# dipanggil otomatis oleh `db-up`/`db-reset`). Hak: PROCESS + REPLICATION CLIENT.
MARIADB_EXPORTER_PASSWORD=lb_exporter_password

# Port Adminer cadangan di host, hanya di-bind ke 127.0.0.1.
# Jalur utama tetap http://adminer.localhost lewat Traefik (tidak butuh port ini).
ADMINER_PORT=8081
