# Salin menjadi `.env` bila ingin mengganti kredensial demo.
# Tanpa `.env`, docker-compose.db.yml memakai nilai default yang sama.
# File `.env` tidak di-commit (lihat .gitignore).

MARIADB_DATABASE=lb_demo
MARIADB_USER=lb_app
# Password `lb_app` juga tertulis di docker/maxscale/maxscale.cnf (MaxScale
# tidak membaca env). Kalau diganti di sini, ganti juga di sana lalu jalankan
# `make db-grant-users` + restart MaxScale.
MARIADB_PASSWORD=lb_app_password
MARIADB_ROOT_PASSWORD=lb_root_password

# User replikasi yang dipakai `CHANGE MASTER TO` oleh replika.
MARIADB_REPL_PASSWORD=lb_repl_password

# User MaxScale untuk memantau peran node dan mempromosikan replika.
# Nilainya juga tertulis di docker/maxscale/maxscale.cnf — kalau diganti di
# sini, ganti juga di sana (MaxScale tidak membaca env).
MARIADB_MONITOR_PASSWORD=lb_monitor_password

# User khusus exporter metrik MariaDB (dibuat oleh `make db-grant-users`,
# dipanggil otomatis oleh `db-up`/`db-reset`). Hak: PROCESS + REPLICATION CLIENT
# + SLAVE MONITOR.
MARIADB_EXPORTER_PASSWORD=lb_exporter_password

# Port Adminer cadangan di host, hanya di-bind ke 127.0.0.1.
# Jalur utama tetap http://adminer.localhost lewat Traefik (tidak butuh port ini).
ADMINER_PORT=8081

# Port host MaxScale, hanya untuk jalur belajar Kubernetes: pod k3d tidak ikut
# network lb-net, jadi mereka menjangkau database lewat host.docker.internal.
# Binding ini terbuka ke LAN mesin; jangan diekspos ke internet.
MAXSCALE_PORT=4006
