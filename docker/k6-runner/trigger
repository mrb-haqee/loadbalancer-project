#!/bin/sh
# CGI pemicu: dipanggil dari link "Run k6" di dashboard Grafana.
# GET hanya menampilkan halaman konfirmasi agar prefetch/reload tidak memicu beban.
# POST memulai tepat satu Run (lock direktori atomik di /tmp tmpfs).

set -u

lock=/tmp/k6.lock
log=/tmp/k6-run.log
status_file=/tmp/k6-last-status
method="${REQUEST_METHOD:-GET}"
rate="${RATE:-100}"
duration="${DURATION:-15s}"

reply() {
  # $1 = HTTP status, $2 = isi HTML, $3 = URL redirect opsional
  printf 'Status: %s\r\n' "$1"
  printf 'Content-Type: text/html; charset=utf-8\r\n'
  printf 'Cache-Control: no-store\r\n'
  if [ -n "${3:-}" ]; then printf 'Refresh: 2; url=%s\r\n' "$3"; fi
  printf '\r\n<!doctype html><html lang="id"><head><meta charset="utf-8"><title>Trigger k6</title>'
  printf '<style>body{font-family:system-ui,sans-serif;max-width:520px;margin:3rem auto;padding:0 1rem;line-height:1.5}button{padding:.6rem 1.2rem;font-size:1rem;cursor:pointer}</style>'
  printf '</head><body>%s</body></html>\n' "$2"
}

last_info=""
if [ -f "$status_file" ]; then
  last_info="<p><small>Status exit Run terakhir: <code>$(cat "$status_file")</code></small></p>"
fi

if [ "$method" != "POST" ]; then
  if [ -d "$lock" ]; then
    reply "200 OK" "<h1>Run sedang berjalan</h1><p>Tunggu Run selesai atau pantau langsung di <a href=\"http://grafana.localhost/d/k6-lb\">dashboard k6</a>.</p>$last_info"
  else
    reply "200 OK" "<h1>Mulai Run k6</h1><p>Target: <code>${rate} req/detik</code> selama <code>${duration}</code> ke <code>http://server.localhost</code>.</p>${last_info}<form method=\"post\" action=\"/cgi-bin/trigger\"><button type=\"submit\">Jalankan Run sekarang</button></form><p><a href=\"http://grafana.localhost/d/k6-lb\">Kembali ke dashboard k6</a></p>"
  fi
  exit 0
fi

if ! mkdir "$lock" 2>/dev/null; then
  reply "409 Conflict" '<h1>Run masih berjalan</h1><p>Tunggu sampai selesai, lalu coba lagi. <a href="http://grafana.localhost/d/k6-lb">Buka dashboard</a></p>'
  exit 0
fi

# stdout/stderr subshell dialihkan supaya httpd tidak menahan respons CGI.
(
  cd /scripts || exit 1
  k6 run load-test.js >"$log" 2>&1
  echo "$?" >"$status_file"
  rmdir "$lock"
) >/dev/null 2>&1 &

reply "202 Accepted" "<h1>Run dimulai</h1><p>Mengalihkan ke dashboard k6 otomatis (${rate} req/detik, ${duration}).</p>" 'http://grafana.localhost/d/k6-lb'
