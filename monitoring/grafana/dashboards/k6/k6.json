      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (server) (last_over_time(k6_served_total{run=~\"$run\"}[$__range]))",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "{{server}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum by (server) (last_over_time(k6_served_total{run=~\"$run\"}[$__range])) / scalar(clamp_min(sum(last_over_time(k6_served_total{run=~\"$run\"}[$__range])), 0.001))",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "{{server}}"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "joinByField",
