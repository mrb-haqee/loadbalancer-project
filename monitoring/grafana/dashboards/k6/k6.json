    "from": "now-30m",
    "to": "now"
  },
  "links": [
    {
      "title": "LB Realtime",
      "url": "/d/lb-realtime",
      "icon": "external link",
      "type": "link",
      "targetBlank": false,
      "includeVars": false,
      "keepTime": false,
      "tooltip": "Trafik nyata di luar Run k6."
    },
    {
      "title": "Database",
      "url": "/d/db-monitoring",
      "icon": "external link",
      "type": "link",
      "targetBlank": false,
      "includeVars": false,
      "keepTime": false,
      "tooltip": "Kesehatan MariaDB dan error query."
    },
    {
      "title": "Run k6 (15 detik)",
      "url": "http://trigger.localhost/cgi-bin/trigger",
      "icon": "external link",
      "type": "link",
      "targetBlank": true,
      "includeVars": false,
      "keepTime": false,
      "tooltip": "Mulai satu Run k6: 100 req/detik selama 15 detik."
    }
  ],
  "templating": {
    "list": [
      {
        "name": "run",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "definition": "label_values(k6_http_reqs_total, run)",
        "query": {
          "qryType": 1,
          "query": "label_values(k6_http_reqs_total, run)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "includeAll": false,
        "multi": true,
        "sort": 2,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Cara baca (atas ke bawah)",
      "gridPos": {
        "h": 4,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "options": {
        "mode": "markdown",
        "content": "**1. Pilih Run** di kanan atas. Default = Run terbaru. Pilih beberapa Run hanya bila ingin membandingkan.\n**2. Ringkasan** = total request, request gagal, check lulus, dan VU maksimum.\n**3. Beban** = request/detik dan latensi; garis p95 harus di bawah **0,5 detik**.\n**4. Sebaran** = tiap Backend harus menerima porsi yang kira-kira sama (~20%).\n\nRun yang sedang dilihat: **$run**. Kalau kosong, klik tautan **\"Run k6 (15 detik)\"** lalu tunggu Run selesai.",
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        }
      }
    },
    {
      "id": 2,
      "type": "row",
      "title": "1. Ringkasan Run",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 4
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total request",
      "description": "**Arti**: seluruh request yang dikirim k6 pada Run terpilih.\n**Normal**: sesuai skenario, 100 req/detik × 15 detik = 1500.\n**Jika kosong**: belum ada Run pada rentang waktu dashboard — jalankan lewat tautan di kanan atas.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "noValue": "Belum ada Run"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(last_over_time(k6_http_reqs_total{run=~\"$run\"}[$__range]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Request gagal",
      "description": "**Arti**: request dengan `expected_response=false` (status di luar 2xx–3xx).\n**Normal**: 0. Ambang k6 yang dipakai: gagal < 1%.\n**Jika > 0**: lihat panel Status code dan Log error di dashboard LB.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(last_over_time(k6_http_reqs_total{run=~\"$run\",expected_response=\"false\"}[$__range])) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Check lulus",
      "description": "**Arti**: persentase pemeriksaan k6 yang lulus (status 200, header `X-Served-By` ada dan valid, isi body cocok).\n**Normal**: 100% (ambang k6: > 99%).\n**Jika turun**: ada kontrak respons yang rusak, bukan sekadar latensi.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg(last_over_time(k6_checks_rate{run=~\"$run\"}[$__range])) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "VU maksimum",
      "description": "**Arti**: jumlah virtual user terbanyak yang dipakai Run ini.\n**Normal**: sekitar 25 untuk 100 req/detik (pre-allocated 25% dari rate).\n**Jika menyentuh `maxVUs`**: skenario kehabisan VU; latensi bisa ikut naik.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max(max_over_time(k6_vus_max{run=~\"$run\"}[$__range])) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ]
    },
    {
