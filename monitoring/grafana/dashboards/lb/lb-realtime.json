      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(traefik_service_requests_total{service=~\"demo@docker|direct-.*@docker\"}[1m]))",
          "legendFormat": "Masuk LB"
