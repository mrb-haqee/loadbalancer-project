    {
      "id": 12,
      "type": "table",
      "title": "Jumlah & porsi request per Backend",
      "description": "**Arti**: total request dan persentasenya selama rentang waktu dashboard.\n**Normal**: masing-masing sekitar 20% (5 Backend).\n**Jika tidak merata**: cek panel di sebelah kiri dan Status target scrape; Traefik hanya membagi ke Backend yang Sehat.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Jumlah"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "unit",
                "value": "short"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Porsi (%)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 10
                    },
                    {
                      "color": "green",
                      "value": 15
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducers": [],
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (server) (increase(lb_backend_requests_total[$__range]))",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "{{server}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum by (server) (increase(lb_backend_requests_total[$__range])) / scalar(clamp_min(sum(increase(lb_backend_requests_total[$__range])), 0.001))",
          "format": "table",
          "instant": true,
          "range": false,
          "legendFormat": "{{server}}"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns"
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "server",
            "mode": "outer"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "server",
                "Value #A",
                "Value #B"
              ]
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {},
            "renameByName": {
              "server": "Backend",
              "Value #A": "Jumlah",
              "Value #B": "Porsi (%)"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Backend",
                "desc": false
              }
            ]
          }
        }
      ]
    },
    {
