{
  "name": "load-balancer-3-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Load balancer Traefik + 3 backend server di Docker, tiap server punya URL sendiri, lengkap dengan test suite dan skenario k6.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "docker:up": "docker compose -p lb-demo up -d --build",
    "docker:down": "docker compose -p lb-demo down --remove-orphans",
    "docker:ps": "docker compose -p lb-demo ps",
    "docker:logs": "docker compose -p lb-demo logs --tail=80",
    "test": "node --test --test-reporter=spec test/docker/lb-docker.test.js",
    "test:docker": "node --test --test-reporter=spec test/docker/lb-docker.test.js",
    "k6:install": "bun scripts/install-k6.js",
    "k6": "bun scripts/k6.js",
    "k6:load": "bun scripts/k6.js run k6/load-test.js",
    "k6:failover": "bun scripts/k6.js run k6/failover.js -e DURATION=40s"
  }
}
